# ---------------------------------------------------------------------------
# JapanToGo - root environment template (Coolify / production deploy)
#
# Copy to `.env` and fill in real values. Never commit the real `.env`.
#
# NOTE: this file is used by docker-compose for the Coolify deployment.
# For LOCAL DEVELOPMENT you do NOT need Docker: configure
# `backend/.env` instead and run the native stack (uvicorn --reload +
# npm run dev) against the PostgreSQL server on localhost:5432.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# --- Database (Coolify) -----------------------------------------------------
# The compose stack does NOT ship a PostgreSQL container: point DATABASE_URL at
# the managed/external PostgreSQL instance. Must use the async driver.
DATABASE_URL=postgresql+asyncpg://postgres:sua_senha@localhost:5432/japantogo

# --- Backend ---------------------------------------------------------------
JWT_SECRET=change-me-generate-a-random-48-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_DOMAIN=.japantogo.com
COOKIE_SECURE=true
CORS_ORIGINS=https://japantogo.com,https://www.japantogo.com

# --- Frontend --------------------------------------------------------------
# Public URL of the API as reachable from the browser.
PUBLIC_API_BASE_URL=https://api.japantogo.com

# --- Host port publishing (Coolify overrides these) ------------------------
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# --- Business rules / simulator --------------------------------------------
JPY_TO_BRL_RATE=0.038
