# ---------------------------------------------------------------------------
# JapanToGo - backend environment template
#
# Copy to `.env` and adjust. Never commit the real `.env`.
#
# The database is a NATIVE PostgreSQL server running on the developer machine
# (default port 5432). No Docker container is used for the database in
# development - docker-compose is reserved for the Coolify deployment.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=false

# --- Database connection ---------------------------------------------------
# SOURCE OF TRUTH for both the application and Alembic (alembic/env.py reads
# this same value through app.core.config.settings).
# Always use the ASYNC driver (postgresql+asyncpg://) so the FastAPI app and
# the migrations can never point to different databases.
DATABASE_URL=postgresql+asyncpg://postgres:sua_senha@localhost:5432/japantogo

# Alternative: compose the URL from the discrete variables below. They are
# only used when DATABASE_URL is empty.
# Local PostgreSQL without a password (trust auth):
#   DATABASE_URL=postgresql+asyncpg://isamumatsuyama@localhost:5432/japantogo
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_NAME=japantogo

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- Security / session ----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-key-change-me-0123456789abcdef
# SECRET_KEY is accepted as an alias of JWT_SECRET.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Domain used for the HTTP-only refresh token cookie (leave empty on localhost).
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ------------------------------------------------------------------
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CALCULATOR=30/minute

# --- Storage ---------------------------------------------------------------
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_INSPECTION_PHOTOS=5
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85

# --- Business rules / simulator --------------------------------------------
JPY_TO_BRL_RATE=0.038
EXCHANGE_RATE_SPREAD=0.02
SERVICE_FEE_RATE=0.20
SERVICE_FEE_MIN_JPY=2000
SERVICE_FEE_FLOOR_THRESHOLD_JPY=10000
RTS_RATE=0.60
ICMS_RATE=0.18
