# ---------------------------------------------------------------------------
# JapanToGo - frontend environment template
# Copy to `.env` and fill in real values.
#
# PUBLIC_* variables are read at runtime by the SvelteKit server
# (adapter-node) and forwarded to the browser through the root layout load.
# ---------------------------------------------------------------------------

# Public base URL of the FastAPI backend, as reachable from the browser.
PUBLIC_API_BASE_URL=http://localhost:8000

# Internal base URL used by SSR load functions when running inside docker-compose.
INTERNAL_API_URL=http://backend:8000

# Runtime port/host for adapter-node.
PORT=3000
HOST=0.0.0.0
